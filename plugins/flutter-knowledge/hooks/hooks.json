{
  "description": "Force-load Flutter/Dart conventions at session start, and format and analyze changed Dart files when a turn ends, in projects with a pubspec.yaml",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/force-flutter-knowledge.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dart-stop-check.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
