{
  "schema_version": 1,
  "contracts": [
    {
      "id": "app_root",
      "paths": [
        "lib/my_app.dart"
      ],
      "symbols": [
        "MyApp"
      ],
      "fixed_path": true,
      "get_it_checks": {
        "const_root": "\\bconst\\s+MyApp\\s*\\(\\s*\\{\\s*super\\.key\\s*\\}\\s*\\)"
      },
      "get_it_absent_checks": {
        "no_widget_locator": "\\bGetIt\\b|\\blocator\\b"
      },
      "conditional_checks": [
        {
          "only_when": {
            "state_management": [
              "flutter_bloc",
              "bloc"
            ]
          },
          "checks": {
            "network_provider_create": "\\bBlocProvider\\s*<\\s*NetworkCubit\\s*>\\s*\\(\\s*create\\s*:",
            "network_provider_eager": "\\bBlocProvider\\s*<\\s*NetworkCubit\\s*>\\s*\\([^;]*?\\blazy\\s*:\\s*false\\b"
          },
          "absent_checks": {
            "no_network_provider_value": "\\bBlocProvider\\s*<\\s*NetworkCubit\\s*>\\s*\\.\\s*value\\b|\\bBlocProvider\\s*\\.\\s*value\\s*\\([^;]*?\\bNetworkCubit\\b"
          }
        },
        {
          "only_when": {
            "routing": [
              "navigator"
            ]
          },
          "checks": {
            "router_initial_route": "\\binitialRoute\\s*:\\s*AppRouter\\.initialRoute\\b"
          },
          "absent_checks": {
            "no_root_route_getter": "\\bString\\s+get\\s+_?initialRoute\\b"
          }
        }
      ]
    },
    {
      "id": "main",
      "paths": [
        "lib/main.dart"
      ],
      "symbols": [
        "main"
      ],
      "fixed_path": true,
      "checks": {
        "binding": "\\bWidgetsFlutterBinding\\.ensureInitialized\\s*\\(",
        "preferences": "\\bCacheHelper\\.init\\s*\\(",
        "registration": "\\bregisterAppDependencies\\s*\\(",
        "skin_load": "\\bawait\\s+\\w+\\s*<\\s*SkinRegistry\\s*>\\s*\\(\\s*\\)\\.load\\s*\\(",
        "root": "\\bMyApp\\s*\\("
      },
      "command_block": true,
      "get_it_checks": {
        "no_arg_registration": "\\bregisterAppDependencies\\s*\\(\\s*\\)",
        "const_root": "\\bconst\\s+MyApp\\s*\\(\\s*\\)"
      },
      "conditional_checks": [
        {
          "only_when": {
            "secure_storage": ["flutter_secure_storage"]
          },
          "checks": {
            "secure_cache_init": "\\bawait\\s+SecureCacheHelper\\.init\\s*\\(",
            "cache_init_order": "\\bawait\\s+CacheHelper\\.init\\s*\\(\\s*\\)\\s*;[\\s\\S]*?\\bawait\\s+SecureCacheHelper\\.init\\s*\\(\\s*\\)\\s*;",
            "secure_before_registration": "\\bawait\\s+SecureCacheHelper\\.init\\s*\\(\\s*\\)\\s*;[\\s\\S]*?\\bregisterAppDependencies\\s*\\("
          }
        }
      ]
    },
    {
      "id": "bloc_observer",
      "paths": [
        "lib/main.dart"
      ],
      "symbols": [
        "main"
      ],
      "category": "state_management",
      "only_when": {
        "state_management": [
          "flutter_bloc",
          "bloc"
        ]
      },
      "checks": {
        "observer_assignment": "\\bBloc\\.observer\\s*=",
        "shared_talker": "\\b\\w+\\s*<\\s*Talker\\s*>\\s*\\("
      }
    },
